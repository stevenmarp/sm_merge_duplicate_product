<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_product_merge_wizard_form" model="ir.ui.view">
        <field name="name">sm.product.merge.wizard.form</field>
        <field name="model">sm.product.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Duplicate Products">
                <group>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="dst_product_id" options="{'no_create': True}"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    The other products are merged into "To Product" and removed. Stock
                    quantities are combined; sales, purchases, invoices, and bills of
                    material are updated automatically. This cannot be undone.
                </div>
                <footer>
                    <button name="action_merge" type="object" string="Merge" class="btn-primary"
                            confirm="Merge the selected products? This cannot be undone."/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sm_product_merge_wizard" model="ir.actions.act_window">
        <field name="name">Merge Products</field>
        <field name="res_model">sm.product.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sm_product_merge_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_sm_product_merge_wizard_template" model="ir.actions.act_window">
        <field name="name">Merge Products</field>
        <field name="res_model">sm.product.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sm_product_merge_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
